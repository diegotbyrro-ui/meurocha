ROCHA_PORTAL_COOKIE_SECRET=
# Endereço público do portal (sem barra no final)
ROCHA_PORTAL_ORIGIN=https://conviterocha.com.br
# Supabase > Project Settings > API (ou botão Connect)
NEXT_PUBLIC_SUPABASE_URL=https://dmxlxjlvwpfgukjgizjr.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (service_role / secret key). SÓ no servidor. Nunca compartilhe.
SUPABASE_SERVICE_ROLE_KEY=
# Prévia local antiga (R1); deixe false
ROCHA_PREVIEW_MODE=false
